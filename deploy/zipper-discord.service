[Unit]
Description=Zipper — Discord relay, always on
After=network-online.target zipper-web.service
Wants=network-online.target

[Service]
Type=simple
# No venv: discord.py and aiohttp are installed for the system python. The
# module form matters -- `python bot/discord_bot.py` puts bot/ on sys.path
# instead of its parent, so `from bot import main` raises ModuleNotFoundError.
# That is exactly how the previous bot died, silently, for 70 days.
ExecStart=/usr/bin/python3 -m bot.discord_bot
WorkingDirectory=/opt/zipper
EnvironmentFile=/opt/zipper/.env
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
