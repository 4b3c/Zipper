[Unit]
Description=Zipper — dashboard, view server, and the door Discord messages come through
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# --daemon is what makes this always-on: without it the server exits when the
# last browser tab closes, which is right for a laptop and wrong for a service.
ExecStart=/usr/bin/python3 -m zipper.serve --host 127.0.0.1 --port 8800 --daemon
WorkingDirectory=/opt/zipper
EnvironmentFile=/opt/zipper/.env
# systemd starts a service with no HOME. Without it git never reads
# ~/.gitconfig, so the embedded Claude session committed as
# root@<hostname> instead of zipper, and `git push` could not find the
# credentials gh had stored.
Environment=HOME=/root
# Kill only python on restart. ttyd and the tmux server are its children, so
# the default control-group kill takes the live Claude conversation down with
# the service -- a restart looked like Discord disconnecting the dashboard.
KillMode=process
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
