[Unit]
Description=Zipper — hourly Canvas refresh (also keeps the session cookie warm)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Two jobs in one call. The obvious one: submitted-vs-due only changes in
# Inbox/canvas.json, so without this the dashboard strikes items through from
# whenever someone last ran `zipper canvas` by hand.
#
# The other one is the experiment. ASU issues no API tokens, so this runs on a
# browser session cookie, and the 2026-09-04 cookie died in under 18 hours
# untouched. Canvas' session timeout is idle-based, so exercising it hourly
# should hold it open indefinitely -- unless the timeout is absolute, or the
# operator's own browser rotates the session by re-authenticating through SSO.
# The journal for this unit is the evidence: the age at which a cookie dies,
# while being polled, tells the three apart.
ExecStart=/usr/bin/python3 -m zipper canvas
WorkingDirectory=/opt/zipper
EnvironmentFile=/opt/zipper/.env
# An expired cookie exits 1 by design and writes nothing. That is a real
# result here, not a crash -- don't let it mark the unit failed and stop the
# timer, or the experiment ends at the first expiry.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
