# brain — configuration is environment-only. Copy to .env (gitignored) and fill in.

# REQUIRED: absolute path to the vault of markdown notes. This is the only thing
# joining this code to a particular person's data.
BRAIN_VAULT=/absolute/path/to/vault

# GitHub. Without a token you get public repos only.
GITHUB_TOKEN=
BRAIN_GH_USER=                 # your GitHub login
BRAIN_GH_ORGS=                 # comma-separated orgs to include; empty = none

# Canvas LMS. The host of your institution's instance, and a personal API token
# if your institution allows self-service tokens. Without one, brain.py canvas
# takes --file with JSON dumped from a logged-in browser.
CANVAS_HOST=https://canvas.instructure.com
CANVAS_TOKEN=

# bot/ only. The Discord relay needs a token and the channel it listens in.
# ZIPPER_URL is where it forwards messages; BOT_URL is where replies come back.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
BOT_URL=http://127.0.0.1:4200

# Where the bot forwards incoming messages. This is Brain, which decides whether
# to paste into a live Claude session, wake a detached one, or start a new one.
BRAIN_URL=http://127.0.0.1:8800

# One tmux session per Brain instance. Only change it to run a second instance
# alongside the real one.
BRAIN_TMUX_SESSION=brain
