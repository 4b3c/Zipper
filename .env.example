# zipper — configuration is environment-only. Copy to .env (gitignored) and fill in.

# REQUIRED: absolute path to the vault of markdown notes. This is the only thing
# joining this code to a particular person's data.
ZIPPER_VAULT=/absolute/path/to/vault

# GitHub. Without a token you get public repos only.
GITHUB_TOKEN=
ZIPPER_GH_USER=                 # your GitHub login
ZIPPER_GH_ORGS=                 # comma-separated orgs to include; empty = none

# Canvas LMS. The host of your institution's instance, and a personal API token
# if your institution allows self-service tokens. Without one, zipper canvas
# takes --file with JSON dumped from a logged-in browser.
CANVAS_HOST=https://canvas.instructure.com
CANVAS_TOKEN=

# bot/ only. The Discord relay needs a token and the channel it listens in.
# ZIPPER_URL is where it forwards messages; BOT_URL is where replies come back.
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
BOT_URL=http://127.0.0.1:4200

# Where the bot forwards incoming messages. This is Zipper, which decides whether
# to paste into a live Claude session, wake a detached one, or start a new one.
ZIPPER_URL=http://127.0.0.1:8800

# One tmux session per Zipper instance. Only change it to run a second instance
# alongside the real one.
ZIPPER_TMUX_SESSION=zipper

# --- the embedded terminal -------------------------------------------------
# ttyd -W hands out a LIVE SHELL on the machine running zipper. The server
# refuses to bind it anywhere but loopback unless a credential is set, which is
# the only thing standing between a browser and a root prompt.
#
# Leave both blank to keep the terminal local-only (the dashboard still works;
# only the Claude card is unreachable from another device).
#
# To use it remotely: set the host to this machine's tailnet address
# (`tailscale ip -4`) and pick a real password -- user:password, no spaces.
ZIPPER_TERM_HOST=
ZIPPER_TERM_CRED=

# --- the GitHub App: Zipper's own identity ---------------------------------
# Register at github.com/settings/apps/new: no webhook, Repository permissions
# -> Contents: Read and write, and nothing else. Install it on ONE repo. The
# App id is on the settings page, the install id is the last path segment of
# the installation URL, and the slug/uid come from `zipper ghapp`.
ZIPPER_GH_APP_ID=
ZIPPER_GH_APP_INSTALL_ID=
ZIPPER_GH_APP_KEY=/opt/zipper/zipper-app.pem
ZIPPER_GH_APP_SLUG=
ZIPPER_GH_APP_UID=

# --- the browser extension's update channel --------------------------------
# Must be https (Firefox refuses a plain-http update URL) and must match the
# `update_url` inside extension/manifest.json.
ZIPPER_EXT_BASE=
AMO_JWT_ISSUER=
AMO_JWT_SECRET=

# --- the timesheet ---------------------------------------------------------
# The Google Sheet id behind `zipper hours` -- the part of its URL after /d/.
# The browser panel asks the server for this rather than carrying it, so the
# published manifest matches spreadsheets in general and names none.
ZIPPER_SHEET_ID=

# web-ext's record of the last AMO upload, rewritten on every sign. Build state,
# not configuration; kept here only so it is not loose in the working tree.
AMO_UPLOAD_UUID=
AMO_XPI_CRC_HASH=
AMO_CHANNEL=unlisted

# --- Google, for the timesheet ---------------------------------------------
# An OAuth client (console.cloud.google.com -> Credentials -> OAuth client ID,
# type "Web application"). Register the redirect URI your zipper-web answers on:
#   https://<machine>.<tailnet>.ts.net:9443/oauth/google/callback
# Scope is requested at runtime, not declared on the client. Run
# `zipper google --auth` for the link, and the callback fills in the token.
ZIPPER_GOOGLE_CLIENT_ID=
ZIPPER_GOOGLE_CLIENT_SECRET=
ZIPPER_GOOGLE_REFRESH_TOKEN=
